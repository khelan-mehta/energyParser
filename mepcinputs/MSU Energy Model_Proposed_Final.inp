case "CON": 20
case "CL":  25
case "LG":  50
case "BR":  50
case "LO":  100
case "RR":  100
case "OO":  150
case "CO":  500
case "LB":  50
case "VIV": 50
case "WR":  1000
case "STO": 1000
case "ELO": 1000
case "JA":  1000
case "COR": 1000
case "ST":  1000
case "LOC": 1000
case "IT":  1000
case "EL":  1000
case "MR":  1000
default:    1000
endswitch}
   ..

